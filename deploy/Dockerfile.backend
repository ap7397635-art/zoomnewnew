# Backend (FastAPI) image
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

# Install deps (cached layer)
COPY backend/requirements.txt /srv/backend/requirements.txt
# emergentintegrations is hosted on Emergent's CloudFront PyPI index — must add as extra.
RUN pip install --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/ -r /srv/backend/requirements.txt

# Copy full project tree so backend can serve worker/, install_vps.sh, docs.
# server.py expects WORKER_DIR = ROOT_DIR.parent / "worker", which means we
# need the project layout preserved at /srv/* — backend at /srv/backend/,
# worker at /srv/worker/, top-level scripts at /srv/.
COPY backend/ /srv/backend/
COPY worker/ /srv/worker/
COPY install_vps.sh /srv/install_vps.sh
# Optional docs (wildcard inside [d] makes COPY tolerant of missing files).
COPY README.m[d] RDP_SETUP.m[d] RDP_SETUP_LINUX.m[d] RDP_STABILITY_CARD.m[d] MAX_BOTS_TUNING.m[d] /srv/

WORKDIR /srv/backend

EXPOSE 8001

CMD ["sh", "-c", "uvicorn server:app --host 0.0.0.0 --port 8001 --workers ${UVICORN_WORKERS:-2} --proxy-headers --forwarded-allow-ips='*'"]
